# Keep real machine paths and secrets in .env.local only.
VIDEO_OS_DATA_ROOT=
# Optional: absolute path to ffprobe when it is not on PATH.
FFPROBE_PATH=
# Phase 6: absolute path to matching Remotion CLI binary (for example node_modules\\.bin\\remotion.cmd on Windows).
REMOTION_CLI_PATH=
# Phase 7: optional path to npx; defaults to npx/npx.cmd and runs `npx hyperframes`.
HYPERFRAMES_NPX_PATH=
# Phase 8: stable video-use clone/skill directory containing SKILL.md and helpers/.
VIDEO_USE_ROOT=
# Optional Python executable used to run video-use helpers.
VIDEO_USE_PYTHON=
