# Keep real machine paths and secrets in .env.local only.
VIDEO_OS_DATA_ROOT=

# Local listener port used when VIDEO_OS_ASSET_BASE_URL is not explicitly configured.
# Keep this aligned with the actual Next listener when using a non-default port.
PORT=3000

# Local asset origin used by Workflow/Remotion rendering.
# Leave empty to derive a trusted loopback origin from PORT. Set an explicit origin only when needed.
VIDEO_OS_ASSET_BASE_URL=
# Set to 1 only when a trusted remote renderer/network must fetch Video OS asset routes directly.
VIDEO_OS_ALLOW_REMOTE_ASSET_ORIGIN=0

# Network exposure is local-first: npm run dev/start bind 127.0.0.1.
# npm run dev:remote / start:remote are explicit opt-in entrypoints that bind 0.0.0.0; use only on a trusted network.

# FFmpeg / ffprobe. Leave paths empty when the executables are already on PATH.
FFMPEG_PATH=
FFPROBE_PATH=
FFMPEG_TIMEOUT_MS=
FFPROBE_TIMEOUT_MS=

# HyperFrames uses the pinned project dependency from node_modules.
HYPERFRAMES_TIMEOUT_MS=

# Remotion uses the pinned @remotion/cli project dependency from node_modules.
REMOTION_RENDER_TIMEOUT_MS=
REMOTION_RENDER_CONCURRENCY=

# Stable video-use clone/skill directory containing SKILL.md and helpers/.
VIDEO_USE_ROOT=
# Optional Python executable used to run video-use helpers.
VIDEO_USE_PYTHON=
VIDEO_USE_TIMEOUT_MS=

# V2.3 production AI providers. Real values belong in .env.local only.
# Never commit a real API key. Model selection is runtime config, not Project JSON.
VOLCENGINE_AGENT_API_KEY=
VOLCENGINE_AGENT_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
