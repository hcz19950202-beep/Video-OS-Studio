# Keep real machine paths and secrets in .env.local only.
VIDEO_OS_DATA_ROOT=
# Optional: absolute path to ffprobe when it is not on PATH.
FFPROBE_PATH=
# Optional absolute path to a matching local Remotion CLI.
# When empty, the app uses npx with the accepted pinned package below.
REMOTION_CLI_PATH=
REMOTION_CLI_PACKAGE=@remotion/cli@4.0.513
# Optional path to npx; defaults to npx/npx.cmd and runs `npx hyperframes`.
HYPERFRAMES_NPX_PATH=
# Stable video-use clone/skill directory containing SKILL.md and helpers/.
VIDEO_USE_ROOT=
# Optional Python executable used to run video-use helpers.
VIDEO_USE_PYTHON=

# V2.3 A3 production AI provider. Real values belong in .env.local only.
# Never commit a real API key. Model selection is runtime config, not Project JSON.
OPENAI_API_KEY=
OPENAI_MODEL=
