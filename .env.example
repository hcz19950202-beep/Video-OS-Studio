# Keep real machine paths and secrets in .env.local only.
VIDEO_OS_DATA_ROOT=
# Optional: absolute path to ffprobe when it is not on PATH.
FFPROBE_PATH=
# Phase 6: absolute path to the Remotion CLI binary (Windows usually node_modules\\.bin\\remotion.cmd).
# Install @remotion/cli at the same version as remotion before local render verification.
REMOTION_CLI_PATH=
